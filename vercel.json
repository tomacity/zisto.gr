{
  "crons": [
    {
      "path": "/api/admin/subscriptions",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/fiscal-queue",
      "schedule": "30 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/fiscal-worker.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "zisto-fiscal-invoices"
        }
      ]
    }
  }
}
