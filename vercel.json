{
  "crons": [
    {
      "path": "/api/admin/subscriptions",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/n/:token",
      "destination": "/api/cards?public_token=:token&source=nfc"
    },
    {
      "source": "/q/:token",
      "destination": "/api/cards?public_token=:token&source=qr"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
